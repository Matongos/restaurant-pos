{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TechPlug POS",
  "version": "1.0.0",
  "identifier": "com.techplug.pos",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TechPlug POS",
        "url": "https://web-delta-five-slu2k38rxm.vercel.app/",
        "width": 1366,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TechPlug",
    "copyright": "© 2026 TechPlug",
    "category": "Business",
    "shortDescription": "Restaurant till, kitchen, tables, stock and profit",
    "longDescription": "TechPlug Restaurant POS: fast till, kitchen screen, tables and split bills, multi-currency change, stock and real profit. Works offline.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
