digraph G { rankdir=LR;   graph [fontname="DejaVu Sans", fontsize=10, bgcolor="transparent", pad=0.2, nodesep=0.35, ranksep=0.45];
  node [fontname="DejaVu Sans", fontsize=9.5, shape=box, style="rounded,filled", fillcolor="white", color="#94a3b8", penwidth=1.1, margin="0.14,0.07"];
  edge [fontname="DejaVu Sans", fontsize=8.5, color="#5b6678", arrowsize=0.7, fontcolor="#374151"];

 o1 [label="Choose\nEat In / Take Away\n/ Delivery"]; o2 [label="Tap the meals\n+ extras"]; o3 [label="Pay\ncash · EcoCash · card\nchange in any currency", fillcolor="#dbe8ff", color="#3b6fd8", penwidth=1.5];
 o4 [label="Hand over the\nnumber (card / slip)"]; o5 [label="Kitchen screen\ntimer starts"]; o6 [label="Kitchen ticks:\nREADY", fillcolor="#dcf3e4", color="#2f9e5b"]; o7 [label="Customer\ncollects"];
 k [label="Keep change\non the customer's account", fillcolor="#fff4cc", color="#d4a514", style="rounded,filled,dashed"];
 o1 -> o2 -> o3 -> o4 -> o5 -> o6 -> o7; o3 -> k [style=dashed, label=" no small change"];
}