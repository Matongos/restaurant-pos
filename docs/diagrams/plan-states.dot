digraph G { rankdir=TB;
  graph [fontname="DejaVu Sans", fontsize=10.5, bgcolor="transparent", pad=0.2, nodesep=0.4, ranksep=0.55];
  node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#94a3b8", penwidth=1.1, margin="0.16,0.08"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#5b6678", arrowsize=0.7, fontcolor="#374151"];
 trial [label="FREE TRIAL\n30 days", fillcolor="#dbe8ff", color="#3b6fd8", penwidth=1.4];
 paid [label="PAID\nRestaurant $15 · Group $35\npaid until a date", fillcolor="#dcf3e4", color="#2f9e5b", penwidth=1.4];
 due [label="DUE SOON\nreminder 7 days before", fillcolor="#fff4cc", color="#d4a514"];
 grace [label="ENDED\n3 days' grace, still selling", fillcolor="#fff4cc", color="#d4a514"];
 paused [label="PAUSED\nno new sales, public pages off\nreports still open", fillcolor="#fde8e8", color="#d14b4b", penwidth=1.4];
 free [label="FREE (given by TechPlug)\nno end date"]; closed [label="CLOSED", fillcolor="#fde8e8", color="#d14b4b"];
 trial -> paid [label=" payment recorded", color="#2f9e5b"]; trial -> grace [label=" 30 days pass"]; trial -> free [style=dashed, label=" console"];
 paid -> due [label=" date nears"]; due -> grace [label=" date passes"]; due -> paid [label=" pays early:\n time added", color="#2f9e5b"];
 grace -> paused [label=" + 3 days"]; paused -> paid [label=" payment recorded —\n tills carry on by themselves", color="#2f9e5b", penwidth=1.3];
 paid -> closed [style=dashed, label=" console"];
 {rank=same; paid; free;}
}
